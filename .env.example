# ── Supabase ──────────────────────────────────────────────────────────────
# Public values: safe to expose, read by the browser client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_ — that would ship it to every
# visitor. Used by the Supabase edge functions in supabase/functions.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 object storage ──────────────────────────────────────────
# Server-only credentials, consumed by the upload-url edge function.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Public read domain for stored media. Also whitelisted for next/image, so the
# image optimiser will refuse any host that is not listed here.
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=

# ── Site ──────────────────────────────────────────────────────────────────
# The canonical public origin. Drives canonical URLs, sitemap.xml, robots.txt
# and Open Graph tags, so it MUST be the real production origin when deployed —
# leaving it as localhost publishes localhost canonicals.
NEXT_PUBLIC_APP_URL=http://localhost:3000
